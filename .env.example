# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL 16)
DATABASE_PROVIDER=postgres
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/nagarbondhu?schema=public"

# Authentication
JWT_SECRET="super_secret_jwt_signing_key_nagarbondhu_2026"
JWT_EXPIRES_IN="7d"

# Google Gemini AI Integration (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-lite"

# Private administrator: run node apps/api/scripts/setup-operator.cjs your@email.com
# Copy these settings to the hosting service for a deployed instance.
OPERATOR_EMAIL=""
OPERATOR_NAME="নগরবন্ধু প্রশাসক"
OPERATOR_PASSWORD_HASH=""

# Duplicate Detection Radius (meters)
MAX_DUPLICATE_DISTANCE_METERS=300

# PostgreSQL mode stores uploaded photos in the database; memory mode uses local files.
STORAGE_PROVIDER="local"
PUBLIC_BASE_URL="http://localhost:5000"
