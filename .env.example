# Copy to apps/api/.env and replace placeholders privately. Never commit apps/api/.env.
PORT=5000
NODE_ENV=development
DATABASE_PROVIDER=memory
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=
GEMINI_MODEL=
OPERATOR_EMAIL=
OPERATOR_NAME=
OPERATOR_PASSWORD_HASH=
MAX_DUPLICATE_DISTANCE_METERS=300
STORAGE_PROVIDER=local
UPLOAD_DIR=
PUBLIC_BASE_URL=http://localhost:5000
RAIN_ALERT_MM=20
# Optional priority weights must be nonnegative and sum to 1.
# PRIORITY_SEVERITY_WEIGHT=0.65
# PRIORITY_AGE_WEIGHT=0.25
# PRIORITY_EVIDENCE_WEIGHT=0.10
