generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CITIZEN
  ADMIN
  URBAN_PLANNER
}

enum ReportCategory {
  ROAD_DAMAGE
  WATERLOGGING
  DRAINAGE
  WASTE
  FOOTPATH
  STREETLIGHT
  OTHER
}

enum ReportStatus {
  SUBMITTED
  AI_ANALYZED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewStatus {
  PENDING
  CONFIRMED_DUPLICATE
  DISMISSED
}

model User {
  id           String    @id @default(uuid())
  displayName  String    @map("display_name")
  email        String?   @unique
  phone        String?   @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(CITIZEN)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  reports       Report[]
  statusHistory ReportStatusHistory[]
  actionEvents ActionAuditEvent[]
  clusterReviews ClusterReview[]
  fieldMissions FieldMission[]

  @@map("users")
}

model Ward {
  id              String   @id @default(uuid())
  wardNumber      Int      @unique @map("ward_number")
  wardName        String   @map("ward_name")
  areaDescription String?  @map("area_description")
  centerLatitude  Float    @map("center_latitude")
  centerLongitude Float    @map("center_longitude")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  reports Report[]
  officers ResponsiblePerson[]
  actionPlans ActionPlan[]

  @@map("wards")
}

model Report {
  id           String         @id @default(uuid())
  reporterId   String?        @map("reporter_id")
  title        String
  description  String
  category     ReportCategory
  userCategory ReportCategory? @map("user_category")
  latitude     Float
  longitude    Float
  addressLabel String?        @map("address_label")
  wardId       String?        @map("ward_id")
  imageUrl     String?        @map("image_url")
  status       ReportStatus   @default(SUBMITTED)
  actionStatus ActionStatus?  @map("action_status")
  sourceType   String         @default("citizen_report") @map("source_type")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  resolvedAt   DateTime?      @map("resolved_at")

  reporter           User?                @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  ward               Ward?                @relation(fields: [wardId], references: [id], onDelete: SetNull)
  aiAnalysis         AiAnalysis?
  priorityAssessment PriorityAssessment?
  statusHistory      ReportStatusHistory[]
  actionRecommendations ActionRecommendation[]
  actionPlan ActionPlan?
  actionEvents ActionAuditEvent[]
  submissionReceipts SubmissionReceipt[]
  feedback CitizenFeedback[]
  notices ReportNotice[]

  duplicatesAsOriginal  PossibleDuplicate[] @relation("ReportOriginal")
  duplicatesAsCandidate PossibleDuplicate[] @relation("ReportCandidate")

  @@index([status])
  @@index([category])
  @@index([latitude, longitude])
  @@index([createdAt])
  @@index([wardId])
  @@map("reports")
}

model AiAnalysis {
  id                 String         @id @default(uuid())
  reportId           String         @unique @map("report_id")
  provider           String
  modelName          String         @map("model_name")
  suggestedCategory  ReportCategory @map("suggested_category")
  summary            String
  severity           Int            // 1 to 5
  confidence         Float?         // 0.0 to 1.0
  reasons            Json           // string array or explanation object
  missingInformation Json?          @map("missing_information")
  createdAt          DateTime       @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("ai_analyses")
}

model PriorityAssessment {
  id               String        @id @default(uuid())
  reportId         String        @unique @map("report_id")
  severityFactor   Int           @map("severity_factor")
  impactFactor     Int           @map("impact_factor")
  recurrenceFactor Int           @map("recurrence_factor")
  ageFactor        Int           @map("age_factor")
  score            Float
  priorityLevel    PriorityLevel @map("priority_level")
  explanation      Json
  assessedAt       DateTime      @default(now()) @map("assessed_at")
  overriddenBy     String?       @map("overridden_by")
  overrideReason   String?       @map("override_reason")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([priorityLevel])
  @@index([score])
  @@map("priority_assessments")
}

model PossibleDuplicate {
  id                String       @id @default(uuid())
  reportId          String       @map("report_id")
  candidateReportId String       @map("candidate_report_id")
  similarityScore   Float        @map("similarity_score")
  matchingReasons   Json         @map("matching_reasons")
  reviewStatus      ReviewStatus @default(PENDING) @map("review_status")
  reviewedBy        String?      @map("reviewed_by")
  reviewedAt        DateTime?    @map("reviewed_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  report          Report @relation("ReportOriginal", fields: [reportId], references: [id], onDelete: Cascade)
  candidateReport Report @relation("ReportCandidate", fields: [candidateReportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([candidateReportId])
  @@index([reviewStatus])
  @@map("possible_duplicates")
}

model ReportStatusHistory {
  id             String       @id @default(uuid())
  reportId       String       @map("report_id")
  previousStatus ReportStatus @map("previous_status")
  newStatus      ReportStatus @map("new_status")
  changedBy      String?      @map("changed_by")
  changedByLabel String?      @map("changed_by_label")
  note           String?
  createdAt      DateTime     @default(now()) @map("created_at")

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@map("report_status_history")
}

enum ActionStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_FIELD_VERIFICATION
  READY_FOR_ASSIGNMENT
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
  REJECTED
}

model Department {
  id String @id
  displayName String @map("display_name")
  active Boolean @default(true)
  source String
  verificationStatus String @map("verification_status")
  officers ResponsiblePerson[]
  actionPlans ActionPlan[]
  @@map("departments")
}

model ResponsiblePerson {
  id String @id
  displayName String @map("display_name")
  title String
  wardId String? @map("ward_id")
  departmentId String @map("department_id")
  contact String?
  active Boolean @default(true)
  source String
  verificationStatus String @map("verification_status")
  ward Ward? @relation(fields: [wardId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  actionPlans ActionPlan[]
  @@index([wardId, active])
  @@map("responsible_persons")
}

model ActionRecommendation {
  id String @id
  reportId String @map("report_id")
  data Json
  provider String
  modelName String @map("model_name")
  isFallback Boolean @map("is_fallback")
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  report Report @relation(fields: [reportId], references: [id])
  plans ActionPlan[]
  @@index([reportId, createdAt])
  @@map("action_recommendations")
}

model ActionPlan {
  id String @id
  reportId String @unique @map("report_id")
  recommendationId String? @map("recommendation_id")
  actionDescription String @map("action_description")
  wardId String @map("ward_id")
  officerId String? @map("officer_id")
  departmentId String @map("department_id")
  assignmentNote String @map("assignment_note")
  wardVerificationNote String @map("ward_verification_note")
  locationOverrideReason String? @map("location_override_reason")
  priority PriorityLevel
  urgency String
  targetDate DateTime @map("target_date")
  adminNotes String @map("admin_notes")
  status ActionStatus @default(ASSIGNED)
  revision Int @default(1)
  resolutionNotes String? @map("resolution_notes")
  verificationMethod String? @map("verification_method")
  verificationStatus String @default("PENDING") @map("verification_status")
  verificationNote String? @map("verification_note")
  verifiedBy String? @map("verified_by")
  verifiedAt DateTime? @map("verified_at")
  beforePhotoUrl String? @map("before_photo_url")
  afterPhotoUrl String? @map("after_photo_url")
  createdBy String @map("created_by")
  updatedBy String @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  report Report @relation(fields: [reportId], references: [id])
  recommendation ActionRecommendation? @relation(fields: [recommendationId], references: [id])
  ward Ward @relation(fields: [wardId], references: [id])
  officer ResponsiblePerson? @relation(fields: [officerId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  progress ActionProgress[]
  events ActionAuditEvent[]
  @@index([status, targetDate])
  @@index([wardId, departmentId, officerId])
  @@map("action_plans")
}

model UploadedImage {
  id String @id
  mimeType String @map("mime_type")
  data Bytes
  createdAt DateTime @default(now()) @map("created_at")
  @@map("uploaded_images")
}

model SubmissionReceipt {
  id String @id
  reportId String @map("report_id")
  fingerprint String
  capabilityHash String @map("capability_hash")
  locationConfirmed Boolean @default(false) @map("location_confirmed")
  locationSource String @map("location_source")
  createdAt DateTime @default(now()) @map("created_at")
  report Report @relation(fields: [reportId], references: [id])
  feedback CitizenFeedback[]
  @@index([reportId])
  @@map("submission_receipts")
}

model CitizenFeedback {
  id String @id
  reportId String @map("report_id")
  receiptId String @map("receipt_id")
  verdict String
  comment String
  reviewStatus String @default("PENDING") @map("review_status")
  reviewedBy String? @map("reviewed_by")
  reviewNote String? @map("review_note")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  report Report @relation(fields: [reportId], references: [id])
  receipt SubmissionReceipt @relation(fields: [receiptId], references: [id])
  @@unique([reportId, receiptId])
  @@index([reviewStatus, createdAt])
  @@map("citizen_feedback")
}

model ReportNotice {
  id String @id
  reportId String @map("report_id")
  message String
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  report Report @relation(fields: [reportId], references: [id])
  @@index([reportId, createdAt])
  @@map("report_notices")
}

model ActionProgress {
  id String @id
  planId String @map("plan_id")
  note String
  photoUrl String? @map("photo_url")
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  plan ActionPlan @relation(fields: [planId], references: [id])
  @@map("action_progress")
}

model ActionAuditEvent {
  id String @id
  reportId String @map("report_id")
  planId String? @map("plan_id")
  actorId String @map("actor_id")
  type String
  note String
  details Json
  createdAt DateTime @default(now()) @map("created_at")
  report Report @relation(fields: [reportId], references: [id])
  plan ActionPlan? @relation(fields: [planId], references: [id])
  actor User @relation(fields: [actorId], references: [id])
  @@index([reportId, createdAt])
  @@map("action_audit_events")
}

model ClusterReview {
  id String @id
  reportIds Json @map("report_ids")
  state String
  evidence String
  sourceType String @map("source_type")
  revision Int @default(1)
  updatedBy String @map("updated_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  actor User @relation(fields: [updatedBy], references: [id])
  @@map("cluster_reviews")
}

model FieldMission {
  id String @id
  title String
  reportIds Json @map("report_ids")
  departmentId String? @map("department_id")
  officerId String? @map("officer_id")
  team String
  status String
  sourceType String @map("source_type")
  route Json
  updates Json
  revision Int @default(1)
  createdBy String @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  actor User @relation(fields: [createdBy], references: [id])
  @@index([sourceType, status])
  @@map("field_missions")
}
